# FinXL server settings. Copy to deploy/.env (Docker) or to .env in the repository root
# (running uvicorn directly). Never commit the real file: it holds the Gemini key.

# ── AI fallback (Gemini) ─────────────────────────────────────────────────────
# Off for the public beta. When true and a key is set, Settings shows the AI section
# and runs may use it. The key stays on the server; browsers never see it.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Limits ───────────────────────────────────────────────────────────────────
# Years per run, runs read at once (keep 1 on a small machine: PyMuPDF is memory-hungry),
# runs per visitor IP per day (0 = unlimited).
MAX_YEARS=12
MAX_CONCURRENT_RUNS=1
RUNS_PER_IP_PER_DAY=10
# A finished identical request younger than this many days is served again instead of re-read.
REUSE_DAYS=7
# Gigabytes of annual-report PDFs to keep (oldest-used removed first). 0 = no limit.
CACHE_MAX_GB=5

# ── Paths (set in the Docker image; change only when running without Docker) ─
# DATA_DIR=./data
# DOCFETCHER_CACHE=~/DocFetcherData
# WEB_DIR=./web/out
# Origins allowed to open the progress stream cross-origin (only for `next dev`). Empty in production.
# DEV_ORIGINS=

# ── Split hosting (web app on Vercel, API elsewhere) ─────────────────────────
# Exact origin(s) of the web app, comma-separated, no trailing slash.
# CORS_ORIGINS=https://finxl.vercel.app
# Optional: also allow Vercel preview deployments of this project.
# CORS_ORIGIN_REGEX=https://finxl-[a-z0-9-]+\.vercel\.app
